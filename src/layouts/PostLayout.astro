---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const { title, description, canonicalURL, pubDatetime, modDatetime } =
  Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};

// JSON.stringify leaves `<` alone, so a title containing `</script>` would
// end the ld+json block early. `\u003c` reads back as `<` for JSON parsers.
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c"
);
---

<Layout {title} {description} {canonicalURL}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </Fragment>

  <slot />
</Layout>
