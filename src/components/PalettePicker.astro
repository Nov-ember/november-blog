---
import IconPalette from "@/assets/icons/IconPalette.svg";
import IconUnderline from "@/assets/icons/IconUnderline.svg";

type Props = { label: string };
const { label } = Astro.props;
---

<div id="palette-picker" class="group relative">
  <button
    type="button"
    aria-expanded="false"
    aria-controls="palette-options"
    class="focus-outline hover:text-accent relative flex size-12 cursor-pointer items-center justify-center sm:size-8"
    aria-label={label}
  >
    <IconPalette aria-hidden="true" class="size-6" />
    <IconUnderline
      aria-hidden="true"
      class="pointer-events-none absolute bottom-0 w-6 scale-125 opacity-0 transition-opacity duration-150 group-data-[open]:opacity-100 motion-reduce:transition-none"
    />
  </button>
  <fieldset
    id="palette-options"
    inert
    class="palette-panel border-border bg-background absolute end-0 top-full z-50 mt-2 w-44 rounded-lg border p-2 shadow-lg"
  >
    <legend class="sr-only">{label}</legend>
    {
      [
        {
          value: "nord",
          name: "Nord",
        },
        {
          value: "catppuccin",
          name: "Catppuccin",
        },
        {
          value: "gruvbox",
          name: "Gruvbox",
        },
        {
          value: "everforest",
          name: "Everforest",
        },
      ].map(palette => (
        <label class="hover:bg-muted has-checked:bg-muted has-[:focus-visible]:outline-accent flex cursor-pointer items-center gap-3 rounded-md px-3 py-3 text-sm transition-colors has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 motion-reduce:transition-none">
          <input
            type="radio"
            name="palette"
            value={palette.value}
            checked={palette.value === "nord"}
            class="peer sr-only"
          />
          <span class="peer-checked:text-accent">{palette.name}</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-accent ms-auto size-4 shrink-0 opacity-0 transition-opacity peer-checked:opacity-100 motion-reduce:transition-none"
          >
            <path d="m5 12 4 4 10-10" />
          </svg>
        </label>
      ))
    }
  </fieldset>
</div>

<style>
  .palette-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.375rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 150ms;
  }

  [data-open] > .palette-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .palette-panel {
      transition: none;
    }
  }
</style>

<script>
  function setOpen(picker: HTMLElement, open: boolean) {
    picker.toggleAttribute("data-open", open);
    picker.querySelector("button")?.setAttribute("aria-expanded", String(open));
    const panel = picker.querySelector<HTMLElement>("#palette-options");
    if (panel) panel.inert = !open;
  }

  // Document listeners survive Astro navigation without being registered again.
  document.addEventListener("click", event => {
    const picker = document.querySelector<HTMLElement>("#palette-picker");
    if (!picker || !(event.target instanceof Node)) return;
    if (picker.querySelector("button")?.contains(event.target)) {
      setOpen(picker, !picker.hasAttribute("data-open"));
    } else if (!picker.contains(event.target)) {
      setOpen(picker, false);
    }
  });

  document.addEventListener("keydown", event => {
    const picker = document.querySelector<HTMLElement>("#palette-picker");
    if (event.key === "Escape" && picker?.hasAttribute("data-open")) {
      setOpen(picker, false);
      picker.querySelector("button")?.focus();
    }
  });

  document.addEventListener("focusin", event => {
    const picker = document.querySelector<HTMLElement>("#palette-picker");
    if (
      picker &&
      event.target instanceof Node &&
      !picker.contains(event.target)
    ) {
      setOpen(picker, false);
    }
  });
</script>
